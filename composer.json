{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "webnuvola/antispambot",
    "description": "Stand-alone antispambot function from WordPress",
    "keywords": ["antispam", "antispambot", "email", "obfuscation", "spam", "wordpress"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Fabio Cagliero",
            "email": "fabio@webnuvola.com"
        }
    ],
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "laravel/pint": "^1.32",
        "pestphp/pest": "^4.7"
    },
    "autoload": {
        "psr-4": {
            "Webnuvola\\Antispambot\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Webnuvola\\Antispambot\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "illuminate/support": "Required to use antispambot_html function"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
